@page "/episodes/new"
@page "/episodes/create"
@attribute [Authorize]
@implements IDisposable
@using VibeCast.Application.Episodes
@using System.Diagnostics
@using System.Text
@inject IEpisodeConceptGenerator EpisodeConceptGenerator
@inject Microsoft.Extensions.Logging.ILogger<EpisodeCreate> Logger

<PageTitle>Create episode</PageTitle>

<div class="breadcrumb-line">
    <a href="/episodes">Episodes</a>
    <span>/</span>
    <span>Create episode</span>
</div>

<div class="page-heading">
    <div>
        <div class="eyebrow">Editorial brief</div>
        <h1>Create an episode</h1>
        <p>
            Define the business and editorial context that VibeCast
            will use to generate an initial episode concept.
        </p>
    </div>
</div>

<div class="form-layout">
    <section class="surface-card">
        <EditForm
            EditContext="editContext"
            OnValidSubmit="PreviewSubmission"
            FormName="create-episode-shell">

            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="form-section">
                <div class="form-section-title">
                    <span>1</span>
                    <div>
                        <h2>Episode identity</h2>
                        <p>Give the workspace a clear editorial purpose.</p>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Episode title</label>
                    <InputText
                        class="form-control"
                        @bind-Value="model.Title"
                        placeholder="Example: Responsible AI in Production" />
                    <ValidationMessage For="() => model.Title" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea
                        class="form-control"
                        rows="4"
                        @bind-Value="model.Description"
                        placeholder="Summarize the subject, intended value, and boundaries." />
                    <ValidationMessage For="() => model.Description" />
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <span>2</span>
                    <div>
                        <h2>Audience and outcome</h2>
                        <p>
                            These values become the editorial context
                            supplied to the model.
                        </p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Target audience</label>
                        <InputText
                            class="form-control"
                            @bind-Value="model.TargetAudience"
                            placeholder="Enterprise .NET developers" />
                        <ValidationMessage For="() => model.TargetAudience" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Preferred tone</label>
                        <InputSelect
                            class="form-select"
                            @bind-Value="model.Tone">
                            <option>Professional and direct</option>
                            <option>Conversational</option>
                            <option>Executive briefing</option>
                            <option>Technical deep dive</option>
                        </InputSelect>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Content objective</label>
                        <InputTextArea
                            class="form-control"
                            rows="3"
                            @bind-Value="model.Objective"
                            placeholder="What should the audience understand or be able to do?" />
                        <ValidationMessage For="() => model.Objective" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <span>3</span>
                    <div>
                        <h2>Publishing preferences</h2>
                        <p>
                            Capture language and scheduling information
                            for the episode workspace.
                        </p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Content language</label>
                        <InputSelect
                            class="form-select"
                            @bind-Value="model.Language">
                            <option>English (United States)</option>
                            <option>English (United Kingdom)</option>
                            <option>Spanish</option>
                            <option>French</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Planned publication date
                        </label>
                        <InputDate
                            class="form-control"
                            @bind-Value="model.PublishDate" />
                    </div>
                </div>
            </div>

            @if (showNotice)
            {
                <div class="alert alert-info">
                    The form is valid. Persistence remains disabled
                    at this teaching checkpoint.
                </div>
            }

            <div class="form-actions">
                <a
                    class="btn btn-outline-secondary"
                    href="/episodes">
                    Cancel
                </a>

                <button
                    class="btn btn-outline-primary"
                    type="button"
                    @onclick="PreviewSubmission">
                    Save draft
                </button>

                <button
                    class="btn btn-primary"
                    type="submit">
                    Save and open workspace
                </button>
            </div>
        </EditForm>
    </section>

    <aside class="surface-card guidance-card">
        <div class="guidance-icon">AI</div>
        <h2>AI episode concept</h2>

        <p>
            Generate an initial concept from the episode title,
            audience, objective, tone, and language.
        </p>

        <button
            class="btn btn-primary w-100"
            type="button"
            disabled="@isGenerating"
            @onclick="GenerateConceptAsync">

            @if (isGenerating)
            {
                <span>Generating concept...</span>
            }
            else
            {
                <span>Generate episode concept</span>
            }
        </button>

        <button
            class="btn btn-primary w-100"
            type="button"
            disabled="@isGenerating"
            @onclick="StreamEpisodeConceptAsync">

            @if (isGenerating)
            {
                <span>Generating concept...</span>
            }
            else
            {
                <span>Stream episode concept</span>
            }
        </button>

        @if (isGenerating)
        {
            <button
                class="btn btn-outline-secondary"
                type="button"
                @onclick="CancelGeneration">
                Stop generation
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(generationError))
        {
            <div
                class="alert alert-danger mt-3"
                role="alert">
                @generationError
            </div>
        }

        @if (isGenerating || !string.IsNullOrWhiteSpace(generatedConcept))
        {
            <div
                class="generated-concept mt-3"
                aria-live="polite"
                aria-atomic="false">

                <div class="generated-concept-heading">
                    <div class="eyebrow">Generated concept</div>

                    @if (isGenerating)
                    {
                        <span
                            class="streaming-status"
                            role="status">
                            Receiving response
                        </span>
                    }
                </div>

                <div class="generated-concept-content">
                    @generatedConcept

                    @if (isGenerating)
                    {
                        <span
                            class="streaming-cursor"
                            aria-hidden="true">
                        </span>
                    }
                </div>
            </div>
        }

        <div class="mini-status mt-3">
            <span class="status-dot"></span>
            <div>
                <strong>Microsoft Foundry model</strong>
                <small>
                    Connected through the VibeCast application boundary.
                </small>
            </div>
        </div>
    </aside>
</div>

@code {
    private readonly EpisodeFormModel model = new EpisodeFormModel();

    private EditContext editContext = default!;
    private CancellationTokenSource? generationCancellation;

    private bool showNotice;
    private bool isGenerating;
    private string? generatedConcept;
    private string? generationError;

    private static readonly TimeSpan GenerationTimeout =
    TimeSpan.FromSeconds(90);

  private static readonly TimeSpan StreamingRenderInterval =
      TimeSpan.FromMilliseconds(75);

    protected override void OnInitialized()
    {
        editContext = new EditContext(model);
    }

    private void PreviewSubmission()
    {
        showNotice = editContext.Validate();
    }

    private async Task GenerateConceptAsync()
    {
        if (isGenerating)
        {
            return;
        }

        generationError = null;
        generatedConcept = null;

        if (!editContext.Validate())
        {
            generationError =
                "Complete the required editorial brief fields " +
                "before generating a concept.";

            return;
        }

        generationCancellation?.Cancel();
        generationCancellation?.Dispose();

        CancellationTokenSource currentCancellation =
            new(TimeSpan.FromSeconds(45));

        generationCancellation = currentCancellation;
        isGenerating = true;

        try
        {
            GenerateEpisodeConceptRequest request = new(
                Title: model.Title,
                Description: model.Description,
                TargetAudience: model.TargetAudience,
                Objective: model.Objective,
                Tone: model.Tone,
                Language: model.Language);

            EpisodeConceptresult result =
                await EpisodeConceptGenerator.GenerateEpisodeConceptAsync(
                    request,
                    currentCancellation.Token);

            generatedConcept = result.Content;
        }
        catch (OperationCanceledException)
            when (currentCancellation.IsCancellationRequested)
        {
            generationError =
                "The generation request was cancelled or exceeded " +
                "the 45-second time limit.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Episode concept generation failed.");

            generationError =
                "VibeCast could not generate the episode concept. " +
                "Verify the Foundry configuration and try again.";
        }
        finally
        {
            if (ReferenceEquals(
                    generationCancellation,
                    currentCancellation))
            {
                generationCancellation = null;
            }

            currentCancellation.Dispose();
            isGenerating = false;
        }
    }

    private async Task StreamEpisodeConceptAsync()
    {
        if (isGenerating)
        {
            return;
        }

        generationError = null;
        generatedConcept = string.Empty;

        if (!editContext.Validate())
        {
            generationError =
                "Complete the required editorial brief fields " +
                "before generating a concept.";

            return;
        }

        generationCancellation?.Cancel();
        generationCancellation?.Dispose();

        CancellationTokenSource currentCancellation =
            new(GenerationTimeout);

        generationCancellation = currentCancellation;
        isGenerating = true;

        StringBuilder conceptBuilder = new();
        long lastRenderTimestamp = Stopwatch.GetTimestamp();

        try
        {
            GenerateEpisodeConceptRequest request = new(
                Title: model.Title,
                Description: model.Description,
                TargetAudience: model.TargetAudience,
                Objective: model.Objective,
                Tone: model.Tone,
                Language: model.Language);

            await foreach (
                string chunk
                in EpisodeConceptGenerator
                    .StreamAsync(
                        request,
                        currentCancellation.Token)
                    .WithCancellation(
                        currentCancellation.Token))
            {
                conceptBuilder.Append(chunk);

                TimeSpan elapsedSinceRender =
                    Stopwatch.GetElapsedTime(
                        lastRenderTimestamp);

                if (elapsedSinceRender < StreamingRenderInterval)
                {
                    continue;
                }

                generatedConcept = conceptBuilder.ToString();

                await InvokeAsync(StateHasChanged);

                lastRenderTimestamp =
                    Stopwatch.GetTimestamp();
            }

            generatedConcept = conceptBuilder.ToString();

            if (string.IsNullOrWhiteSpace(generatedConcept))
            {
                throw new InvalidOperationException(
                    "The episode concept stream contained no text.");
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
            when (currentCancellation.IsCancellationRequested)
        {
            generatedConcept = conceptBuilder.ToString();

            generationError =
                generatedConcept.Length > 0
                    ? "Generation stopped. The partial concept is shown."
                    : "Generation was cancelled before content was received.";
        }
        catch (Exception exception)
        {
            generatedConcept = conceptBuilder.ToString();

            Logger.LogError(
                exception,
                "Episode concept streaming failed.");

            generationError =
                generatedConcept.Length > 0
                    ? "The stream ended unexpectedly. Partial content is shown."
                    : "VibeCast could not stream the episode concept. " +
                      "Verify the Foundry configuration and try again.";
        }
        finally
        {
            if (ReferenceEquals(
                    generationCancellation,
                    currentCancellation))
            {
                generationCancellation = null;
            }

            currentCancellation.Dispose();
            isGenerating = false;
        }
    }

    private void CancelGeneration()
    {
        generationCancellation?.Cancel();
    }
    public void Dispose()
    {
        CancellationTokenSource? cancellation =
            Interlocked.Exchange(
                ref generationCancellation,
                null);

        cancellation?.Cancel();
        cancellation?.Dispose();
    }

    private sealed class EpisodeFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(
            160,
            MinimumLength = 5)]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(2_000)]
        public string Description { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(
            160,
            MinimumLength = 3)]
        public string TargetAudience { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(
            600,
            MinimumLength = 3)]
        public string Objective { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(80)]
        public string Tone { get; set; } =
            "Professional and direct";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(80)]
        public string Language { get; set; } =
            "English (United States)";

        public DateTime? PublishDate { get; set; }
    }
}