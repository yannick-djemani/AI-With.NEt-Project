@page
@model VibeCast.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}
<h1 class="h3 mt-3">Sign out</h1>
<p>Confirm that you want to end the current VibeCast session.</p>
<form method="post">
  <button type="submit" class="btn btn-primary">Sign out</button>
  <a href="/" class="btn btn-outline-secondary">Cancel</a>
</form>
